#!/usr/bin/env bash
set -euo pipefail

REPO="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if (( $# )); then
  echo "Usage: ./install" >&2
  exit 2
fi

# Don't let a personal .stowrc enable --adopt or --override.
cd -- "$REPO"
exec env HOME="$REPO" stow --no-folding --verbose --dir="$REPO/home" --target="$HOME" .
